---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/ui';

// Stránka, na kterou Formspree vrátí návštěvníka po odeslání poptávky.
// Dnes skončí na cizí stránce formspree.io a z webu odejde.
const t = useTranslations('cs');
const booking = await getEntry('booking', 'cs/booking');
const { thanksHeading, thanksText } = booking!.data;
---

<Layout locale="cs" title={`${thanksHeading} — Moser 2506`} description={thanksText}>
  <section class="section">
    <div class="container">
      <h1>{thanksHeading}</h1>
      <p>{thanksText}</p>
      <a class="button" href={getRelativeLocaleUrl('cs', '/')}>{t('error.404.back')}</a>
    </div>
  </section>
</Layout>
