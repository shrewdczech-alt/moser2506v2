---
import type { Locale } from '../config/site';
import { site } from '../config/site';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

// Dokumenty mají pevné cesty - nahrazují se přepsáním souboru stejného jména,
// takže odkaz zůstává platný napořád.
const docs =
  locale === 'cs'
    ? [
        { href: '/dokumenty/provozni-rad.pdf', label: t('docs.rules') },
        { href: '/dokumenty/gdpr.pdf', label: t('docs.gdpr') },
      ]
    : [
        { href: '/dokumenty/accommodation-rules.pdf', label: t('docs.rules') },
        { href: '/dokumenty/gdpr-en.pdf', label: t('docs.gdpr') },
      ];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <p class="footer__name">Moser 2506</p>
      <p class="footer__address">
        {site.address.street}, {site.address.city}, {site.address.zip}
      </p>
    </div>

    <ul class="footer__links">
      <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      {docs.map((doc) => (
        <li><a href={`${base}${doc.href}`}>{doc.label}</a></li>
      ))}
    </ul>
  </div>

  <p class="footer__copy">© {year} Moser 2506 — {t('footer.rights')}</p>
</footer>

<style>
  .footer {
    padding-block: var(--space-12) var(--space-6);
    background: var(--color-dark);
    color: var(--color-text-inverse);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .footer__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .footer__address {
    margin: 0;
    color: #c2ccd3;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__copy {
    margin: var(--space-8) 0 0;
    text-align: center;
    font-size: var(--text-sm);
    color: #98a6b0;
  }
</style>
