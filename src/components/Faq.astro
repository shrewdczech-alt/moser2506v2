---
import { getEntry } from 'astro:content';
import type { Locale } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry('faq', `${locale}/faq`);
if (!entry) throw new Error(`Chybí obsahový soubor src/content/${locale}/faq.md`);
const { heading, subheading, items, documents } = entry.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section section--alt" id="FAQ">
  <div class="container faq">
    <h2>{heading}</h2>
    <p class="section__lead">{subheading}</p>

    <div class="faq__items">
      {items.map((item, index) => (
        <details class="faq__item" name="faq" open={index === 0}>
          <summary class="faq__question">{item.question}</summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>

    <ul class="faq__docs">
      {documents.map((doc) => (
        <li>
          <a class="faq__doc" href={`${base}${doc.file}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
              <path d="M14 3v5h5" />
            </svg>
            {doc.label}
            <span class="faq__doc-format">PDF</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .faq {
    max-width: 48rem;
  }

  .section__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .faq__items {
    display: grid;
    gap: var(--space-2);
  }

  .faq__item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* Minimálně 44px na výšku kvůli pohodlnému trefení prstem. */
    min-height: 44px;
    padding: var(--space-4) var(--space-6);
    font-family: var(--font-heading);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: '';
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translate(-0.15rem, -0.15rem);
    transition: transform 150ms ease;
  }

  .faq__item[open] .faq__question::after {
    transform: rotate(225deg) translate(-0.15rem, -0.15rem);
  }

  .faq__answer {
    margin: 0;
    padding: 0 var(--space-6) var(--space-6);
    color: var(--color-text-muted);
  }

  .faq__docs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .faq__doc {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .faq__doc:hover {
    border-color: var(--color-dark);
  }

  .faq__doc-format {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
  }
</style>
